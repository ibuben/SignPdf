<Window x:Class="SignPdf.App.SignaturesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SignPdf.App"
        Title="{local:Loc signatures_title}"
        Height="460" Width="820"
        MinHeight="320" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource TextBrush}"
        Icon="pack://application:,,,/icon-small.png">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="Vis"/>
        <local:OkToBrushConverter x:Key="OkBrushConv"/>
        <local:OkToGlyphConverter x:Key="OkGlyphConv"/>
        <local:SignatureStatusLocConverter x:Key="StatusLoc"/>
        <DataTemplate x:Key="StatusMark">
            <Grid Width="22" Height="22">
                <Ellipse Fill="{Binding Converter={StaticResource OkBrushConv}}"/>
                <TextBlock Text="{Binding Converter={StaticResource OkGlyphConv}}"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           Foreground="White"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <Grid Margin="0,0,10,0" VerticalAlignment="Center"
                      Visibility="{Binding HasResults, Converter={StaticResource Vis}}">
                    <Grid Width="22" Height="22">
                        <Ellipse Fill="{Binding AllOk, Converter={StaticResource OkBrushConv}}"/>
                        <TextBlock Text="{Binding AllOk, Converter={StaticResource OkGlyphConv}}"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Foreground="White"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="16,12">
            <Button Content="{local:Loc close}" IsDefault="True" IsCancel="True" HorizontalAlignment="Right"
                    MinWidth="110" Click="CloseClick"/>
        </Border>
        <ListBox ItemsSource="{Binding Signatures}" BorderThickness="0" Background="Transparent"
                 Padding="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch"
                 MouseDoubleClick="SignatureDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                            Cursor="Hand">
                        <DockPanel>
                            <ContentPresenter Content="{Binding IsOk}" ContentTemplate="{StaticResource StatusMark}"
                                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding SignerName}" FontWeight="SemiBold" TextWrapping="WrapWithOverflow"/>
                                <TextBlock Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource StatusLoc}">
                                            <Binding Path="Status"/>
                                            <Binding Path="FollowedByLaterSignature"/>
                                            <Binding Source="{x:Static local:Loc.Instance}" Path="Version"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Text="{Binding FieldName}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
