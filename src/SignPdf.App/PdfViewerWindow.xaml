<Window x:Class="SignPdf.App.PdfViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SignPdf.App"
        Title="{local:Loc viewer_title}"
        Height="820" Width="980"
        MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ViewerCanvasBrush}"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource TextBrush}"
        Icon="pack://application:,,,/icon-small.png"
        PreviewMouseWheel="OnPreviewMouseWheel"
        PreviewKeyDown="OnPreviewKeyDown">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="220" Margin="0,0,6,0">
                        <TextBox x:Name="SearchBox" Padding="10,7" VerticalContentAlignment="Center"
                                 TextChanged="SearchTextChanged" KeyDown="SearchKeyDown"/>
                        <TextBlock x:Name="SearchPlaceholder" Text="{local:Loc search_placeholder}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                    </Grid>
                    <Button Style="{StaticResource GhostButton}" Content="↑" Width="36" Padding="0,6"
                            Click="SearchPrevClick" ToolTip="Shift+Enter"/>
                    <Button Style="{StaticResource GhostButton}" Content="↓" Width="36" Padding="0,6" Margin="4,0,0,0"
                            Click="SearchNextClick" ToolTip="Enter"/>
                    <TextBlock x:Name="SearchCount" MinWidth="64" Margin="8,0,8,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                    <Button x:Name="SignatureButton" Style="{StaticResource GhostButton}" Content="{local:Loc show_signature}"
                            Click="ShowSignatureClick" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Content="−" Width="36" Padding="0,6" Click="ZoomOutClick"/>
                    <TextBlock x:Name="ZoomLabel" Width="56" Text="100%" TextAlignment="Center"
                               VerticalAlignment="Center" Margin="6,0"/>
                    <Button Style="{StaticResource GhostButton}" Content="+" Width="36" Padding="0,6" Click="ZoomInClick" Margin="0,0,8,0"/>
                    <Button x:Name="FitWidthButton" Style="{StaticResource GhostButton}" Content="{local:Loc fit_width}" Click="FitWidthClick" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource GhostButton}" Width="28" Height="28" Padding="0" Margin="0,0,12,0"
                            Click="ThemeClick"
                            ToolTip="{Binding Source={x:Static local:Theme.Instance}, Path=ToggleHint}">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="{Binding Source={x:Static local:Theme.Instance}, Path=Icon}"/>
                    </Button>
                    <TextBlock x:Name="PageLabel" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="12,8">
            <TextBlock x:Name="StatusLabel" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                       Text="{local:Loc opening}"/>
        </Border>
        <ScrollViewer x:Name="Scroller" Padding="24,16" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto" SizeChanged="ScrollerSizeChanged">
            <ItemsControl x:Name="PagesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" Margin="0,0,0,16" HorizontalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.35" Color="#000000"/>
                            </Border.Effect>
                            <Grid Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}">
                                <Image Source="{Binding Image}" Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <ItemsControl ItemsSource="{Binding Highlights}" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding Width}" Height="{Binding Height}"
                                                    CornerRadius="1" IsHitTestVisible="False">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#66F7D046"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Background" Value="#99F59E0B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
