<Window x:Class="SignPdf.App.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SignPdf.App"
        Title="{local:Loc details_title}"
        Height="520" Width="640"
        MinHeight="360" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource TextBrush}"
        Icon="pack://application:,,,/icon-small.png">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource GhostButton}" Content="{local:Loc copy}" Click="CopyClick" Margin="0,0,8,0"/>
                <Button Content="{local:Loc close}" IsDefault="True" IsCancel="True" Click="CloseClick" MinWidth="110"/>
            </StackPanel>
        </Border>
        <Border Margin="16" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16">
            <TextBox x:Name="ReportBox"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     IsReadOnly="True"
                     BorderThickness="0"
                     Background="Transparent"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="13"
                     FontFamily="Consolas, Segoe UI"/>
        </Border>
    </DockPanel>
</Window>
